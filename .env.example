# ===== Server =====
PORT=3000
NODE_ENV=production
# Comma-separated list of allowed origins for CORS, or * for any
CORS_ORIGIN=*
# Optional shared-secret to protect ingest/chat endpoints (leave blank to disable)
APP_API_KEY=

# ===== Gemini (the only API key you need) =====
# Get a free key at https://aistudio.google.com/app/apikey -- no credit card required.
# This single key powers both the LLM answers and the embeddings below.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024

# ===== Embeddings (Gemini's own embedding model) =====
EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 supports 768, 1536, or 3072. 768 is smaller/faster
# and plenty accurate for a project-scale knowledge base.
EMBEDDING_DIMENSION=768

# ===== Vector store (local JSON file, no external database) =====
# NOTE: on most free hosts (including Render's free tier) this resets on
# redeploy/restart since the filesystem is ephemeral. Fine for a demo --
# just re-ingest your documents after a redeploy.
VECTOR_STORE_PATH=./data/vectorstore.json

# ===== RAG behavior =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_UPLOAD_MB=15
