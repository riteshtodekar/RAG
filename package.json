{
  "name": "gemini-rag-app",
  "version": "1.0.0",
  "description": "Free RAG application using Gemini for both embeddings and generation, with a local JSON vector store. No external database or extra API keys needed.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ingest-sample": "node scripts/ingest-sample.js"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "multer": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1"
  }
}
